{
  "manifest_version": 3,
  "name": "Jev Tab Cleaner",
  "version": "1.0.0",
  "description": "Tell it what you're working on; it finds the tabs related to that task and lets you close everything else in one click.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://tabman.onrender.com/*",
    "https://tabman-two.vercel.app/*",
    "http://localhost/*",
    "https://*.vercel.app/*",
    "https://*.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jev Tab Cleaner"
  }
}